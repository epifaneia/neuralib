# Copy to .env for local development and fill in the first line.
# On Heroku, set these as config vars instead (heroku config:set ...).

# Required: Postgres with pgvector. Neon's free plan works (use the direct, not pooled, connection).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: semantic search. A Gemini API key from Google AI Studio; without it the catalog
# still works, by keyword only. Use a project without billing so nothing can be charged.
# GEMINI_API_KEY=
# SEMANTIC_SEARCHES_PER_VISITOR_PER_DAY=30
# SEMANTIC_SEARCHES_PER_DAY=500

# DEBUG=1
# SECRET_KEY=change-me
# ALLOWED_HOSTS=localhost,127.0.0.1,.herokuapp.com
# CSRF_TRUSTED_ORIGINS=https://your-app.herokuapp.com
